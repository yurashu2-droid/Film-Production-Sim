# ゲーム本体だけを載せる。制作途中の素材や資料、Godot本体は載せない
/*
!/.gitignore
!/README.md
!/.gitattributes
!/godot/
!/play_film.bat
!/play_lab.bat
!/play_solo.bat
!/play_host.bat
!/play_join.bat
!/run_tests.sh
!/play_vfx.bat
!/play_new_jobs.bat
!/AGENTS.md
!/CLAUDE.md
!/VFX_KNOWLEDGE.md
!/tools/
/tools/*
!/tools/build_vfx_knowledge.py
!/tools/uvi_direct/
!/.claude/
/.claude/*
!/.claude/skills/

# Godotが自動で作るもの
godot/.godot/
godot/tests/shots/

# 再配布できない素材から作ったSE（公開しない。無いときは公開できる音か合成音で鳴る）
godot/assets/audio/sfx_local/

# 別に配る予定の VFX パックと、その確認用（公開リポジトリに載せるかは作者が決める。決まるまで載せない）
godot/addons/origami_vfx/
godot/addons/punk_ink_vfx/
godot/tests/origamitest.gd*
godot/tests/origami_shots.*
godot/tests/punkpacktest.gd*
godot/tests/punk_xl_shots.*

# サブエージェントのパッチ用の一時的な鍵
tools/.patch.lock
