static func find(kind: String) -> Dictionary:
	for item: Dictionary in ITEMS:
		if item["kind"] == kind:
			return item
	return {}


static func has_kind(kind: String) -> bool:
	return not find(kind).is_empty()


static func kinds() -> Array:
	var result: Array = []
	for item: Dictionary in ITEMS:
		result.append(item["kind"])
	return result
